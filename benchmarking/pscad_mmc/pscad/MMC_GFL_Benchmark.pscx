    <Definition classid="UserCmpDefn" name="MMC_PWM" url="" version="" build="" crc="97279675" instances="4" key="" view="false" date="1791293566" id="2000300502">
      <paramlist name="">
        <param name="Description" value="" />
      </paramlist>
      <form name="" w="450" h="500" splitter="75">
        <category name="Parameters" visible="true">
          <cond />
          <parameter desc="Switch OFF resistance (for each element)" name="RSOff" group="Cell parameters" unit="ohm" min="1.0e-20" max="+1e+308" content_type="Constant" type="Real" helpmode="Append" intent="Input" dim="1">
            <value>1.0e8 [ohm]</value>
            <cond />
            <help />
          </parameter>
          <parameter desc="Cell DC capacitor" name="Cdc" group="Cell parameters" unit="uF" min="0" max="+1e+308" content_type="Constant" type="Real" helpmode="Append" intent="Input" dim="1">
            <value>3000 [uF]</value>
            <cond />
            <help />
          </parameter>
          <parameter type="Real" name="Cfreq" desc="Carrier frequency as multiple of fundamental" group="" helpmode="Append" content_type="Variable" intent="Input" min="" max="" unit="Hz" dim="1">
            <value>33</value>
            <help />
            <cond />
          </parameter>
          <parameter desc="AC system frequency" name="fref" group="General" unit="Hz" min="0" max="+1e+308" content_type="Variable" type="Real" helpmode="Append" intent="Input" dim="1">
            <value>50 [Hz]</value>
            <cond />
            <help />
          </parameter>
          <parameter desc="Arm reactor" name="Larm" group="" unit="H" min="0" max="+1e+308" content_type="Constant" type="Real" helpmode="Append" intent="Input" dim="1">
            <value>1.0e-5 [H]</value>
            <cond />
            <help />
          </parameter>
          <parameter desc="Sum of capacitor voltages per arm at t=0 [kV]" name="SumVc0" group="General" unit="kV" min="0.0" max="+1e+308" content_type="Constant" type="Real" helpmode="Append" intent="Input" dim="1">
            <value>0.0 [kV]</value>
            <cond>
            </cond>
            <help>
            </help>
          </parameter>
          <parameter desc="Enable midpoint ground [1: Enable; 0: Disable]" name="EnGnd" group="" unit="" min="0" max="1" content_type="Variable" type="Integer" helpmode="Append" intent="Input" dim="1">
            <value>1</value>
            <cond />
            <help />
          </parameter>
          <parameter desc="Rated AC voltage" name="Vacbase" group="Rated Values" unit="kV" min="0" max="+1e+308" content_type="Literal" type="Real" helpmode="Append" intent="Input" dim="1">
            <value>350 [kV]</value>
            <cond />
            <help />
          </parameter>
          <parameter desc="Rated MVA" name="Sbase" group="Rated Values" unit="MVA" min="0" max="+1e+308" content_type="Literal" type="Real" helpmode="Append" intent="Input" dim="1">
            <value>100 [MVA]</value>
            <cond />
            <help />
          </parameter>
          <parameter desc="Switch ON resistance (for each element)" name="RSOn" group="Cell parameters" unit="ohm" min="1.0e-20" max="+1e+308" content_type="Constant" type="Real" helpmode="Append" intent="Input" dim="1">
            <value>0.005 [ohm]</value>
            <cond />
            <help />
          </parameter>
          <parameter desc="CCSC regulator gain" name="Kp" group="CCSC" unit="" min="0" max="+1e+308" content_type="Variable" type="Real" helpmode="Append" intent="Input" dim="1">
            <value>0.1</value>
            <cond />
            <help />
          </parameter>
          <parameter desc="CCSC regulator time constant" name="Ti" group="CCSC" unit="" min="0" max="+1e+308" content_type="Variable" type="Real" helpmode="Append" intent="Input" dim="1">
            <value>0.1</value>
            <cond />
            <help />
          </parameter>
          <parameter desc="Enable [1] or Disable [0] CCSC" name="CCSCEn" group="" unit="" min="0" max="1" content_type="Variable" type="Integer" helpmode="Append" intent="Input" dim="1">
            <value>1</value>
            <cond />
            <help />
          </parameter>
        </category>
      </form>
