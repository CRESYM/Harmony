            <help />
          </parameter>
          <parameter desc="PI controller time constant" name="Ti" group="" unit="" min="0" max="+1e+308" content_type="Variable" type="Real" helpmode="Append" intent="Input">
            <value>0.1</value>
            <cond />
            <help />
          </parameter>
          <parameter desc="Rated current [kA]" name="Ibase" group="" unit="" min="0" max="+1e+308" content_type="Variable" type="Real" helpmode="Append" intent="Input">
            <value>2 [kA]</value>
            <cond />
