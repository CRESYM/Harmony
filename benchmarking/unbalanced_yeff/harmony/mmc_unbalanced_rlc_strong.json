            "connected_buses": [
                { "bus_id": "Bpcc", "terminal": 1 },
                { "bus_id": "Bdc", "terminal": 2 }
            ],
            "enabled": true
        },
        {
            "id": "Vs_dc",
            "location": "DC1",
            "type": "dc_source",
            "pins": 2,
            "voltage": [200.0, -200.0],
