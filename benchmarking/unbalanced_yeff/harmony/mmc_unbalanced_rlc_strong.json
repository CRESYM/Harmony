        { "id": "Bpcc", "location": "AC1", "pins": 3, "enabled": true },
        { "id": "Bdc", "location": "DC1", "pins": 2, "enabled": true }
    ],
    "components": [
        {
            "id": "MMC1",
            "location": "AC1_DC1",
            "type": "mmc",
            "converter_params": [
                314.1592653589793, 0.0, 0.0, 0.0, 200.0, 0.0, 400.0,
                0.0529, 0.1663, 0.0017568, 36.0, 0.01, 10.0, 0.0
