        "frequency_range": { "start": 10, "end": 1000, "points": 31 }
    },
    "buses": [
        { "id": "gnd", "location": "GND", "pins": 1, "enabled": true },
        { "id": "Bsrc", "location": "AC1", "pins": 3, "enabled": true },
