{
    "simulation": {
        "title": "pi_p2p_cable_readme",
        "description": "PowerImpedance examples/README.md P2P DC cable geometry (100 km bipolar layers).",
        "output_directory": "./benchmarking/powerimpedance_examples/results",
        "frequency_range": { "start": 10, "end": 1000, "points": 100 }
    },
    "buses": [
        { "id": "bus1", "location": "DC1", "pins": 1, "enabled": true },
        { "id": "bus2", "location": "DC1", "pins": 1, "enabled": true }
    ],
    "components": [
        {
            "id": "dc_line",
            "location": "DC1",
            "type": "cable",
            "cable_type": "underground",
            "length": 100000.0,
            "earth": [1.0, 1.0, 100.0],
            "conductors": [
                { "id": "C1", "ri": 0.0, "ro": 0.02425, "resistivity": 1.72e-8 },
                { "id": "C2", "ri": 0.04175, "ro": 0.04625, "resistivity": 2.2e-7 },
                { "id": "C3", "ri": 0.04975, "ro": 0.06055, "resistivity": 1.8e-7, "permeability": 10.0 }
            ],
            "insulators": [
                { "id": "I1", "ri": 0.02425, "ro": 0.04175, "permittivity": 2.3 },
                { "id": "I2", "ri": 0.04625, "ro": 0.04975, "permittivity": 2.3 },
                { "id": "I3", "ri": 0.06055, "ro": 0.06575, "permittivity": 2.3 }
            ],
            "positions": [[-0.5, 1.0], [0.5, 1.0]],
            "connected_buses": [
                { "bus_id": "bus1", "terminal": 1 },
                { "bus_id": "bus2", "terminal": 2 }
            ],
            "enabled": true
        }
    ],
    "computations": [
        {
            "type": "y_matrix",
            "component_id": "dc_line",
            "frequency_range": { "start": 10, "end": 1000, "points": 100 },
            "plot": false
        }
    ]
}
