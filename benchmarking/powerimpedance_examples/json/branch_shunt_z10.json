{
    "simulation": {
        "title": "pi_branch_shunt_z10",
        "description": "PowerImpedance Gridspace_uncertainty deterministic case: branch Z=10, shunt Z=20.",
        "output_directory": "./benchmarking/powerimpedance_examples/results",
        "frequency_range": { "start": 1, "end": 1000, "points": 40 }
    },
    "buses": [
        { "id": "bus", "location": "AC1", "pins": 1, "enabled": true },
        { "id": "gnd", "location": "AC1", "pins": 1, "enabled": true }
    ],
    "components": [
        {
            "id": "branch",
            "location": "AC1",
            "type": "impedance",
            "pins": 1,
            "values": [10.0],
            "connected_buses": [
                { "bus_id": "bus", "terminal": 1 },
                { "bus_id": "gnd", "terminal": 2 }
            ],
            "enabled": true
        },
        {
            "id": "shunt",
            "location": "AC1",
            "type": "impedance",
            "pins": 1,
            "values": [20.0],
            "connected_buses": [
                { "bus_id": "bus", "terminal": 1 },
                { "bus_id": "gnd", "terminal": 2 }
            ],
            "enabled": true
        }
    ],
    "computations": [
        { "type": "print_connections" },
        { "type": "y_matrix", "component_id": "branch", "plot": false },
        { "type": "y_matrix", "component_id": "shunt", "plot": false }
    ]
}
