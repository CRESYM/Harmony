{
    "simulation": {
        "title": "dqsym_stability_snapshot",
        "description": "DQsym MMC transient with scheduled snapshot stability and plot-pick reassessment (no OPF).",
        "output_directory": "./files",
        "frequency_range": {
            "start": 1.0,
            "end": 1000.0,
            "points": 100
        }
    },
    "buses": [
        { "id": "gnd", "location": "GND", "pins": 1, "enabled": true },
        { "id": "AC1", "location": "AC1", "pins": 3, "enabled": true },
        { "id": "DC1", "location": "DC1", "pins": 2, "enabled": true }
    ],
    "components": [
        {
            "id": "MMC1",
            "location": "AC1_DC1",
            "type": "mmc",
            "converter_params": [
                314.1592653589793, 0.0, 0.0, 0.0, 200.0, 0.0, 400.0,
                0.0529, 0.1663, 0.0017568, 36.0, 0.01, 10.0, 0.0
            ],
            "controller_params": [
                0,
                0,
                1, 0, 0.000257, 0.0032, 1, 1000.0,
                0,
                0,
                0,
                0,
                1, 0, 48.0, 480.0, 2, 0.0, 0.0,
                0,
                0
            ],
            "connected_buses": [
                { "bus_id": "AC1", "terminal": 1 },
                { "bus_id": "DC1", "terminal": 2 }
            ],
            "enabled": true
        },
        {
            "id": "Vs_dc",
            "location": "DC1",
            "type": "dc_source",
            "pins": 2,
            "voltage": [200.0, -200.0],
            "resistance": 0.0,
            "connected_buses": [
                { "bus_id": "DC1", "terminal": 1 },
                { "bus_id": "gnd", "terminal": 2 }
            ],
            "enabled": true
        },
        {
            "id": "Vs_ac",
            "location": "AC1",
            "type": "ac_source",
            "pins": 3,
            "voltage": 200.0,
            "values": [0.0],
            "connected_buses": [
                { "bus_id": "AC1", "terminal": 1 },
                { "bus_id": "gnd", "terminal": 2 }
            ],
            "enabled": true
        }
    ],
    "computations": [
        {
            "type": "dqsym",
            "plot": true,
            "dt": 2e-5,
            "t_start": 0.0,
            "t_end": 2.0,
            "frequency": 50.0,
            "n_keep": 5,
            "output_bus_ids": ["AC1"],
            "snapshot_times": [1.0],
            "snapshot_history_stride": 100,
            "stability_at_snapshots": {
                "converter_id": "MMC1",
                "location": "AC",
                "plot": true,
                "plot_type": "bode"
            },
            "stability_on_pick": {
                "converter_id": "MMC1",
                "location": "AC",
                "plot": true,
                "plot_type": "bode"
            }
        }
    ]
}
